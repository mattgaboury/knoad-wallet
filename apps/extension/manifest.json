{
  "manifest_version": 3,
  "name": "KNOAD Wallet",
  "version": "0.1.0",
  "description": "KNOAD Wallet. Signing stays on your phone.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "KNOAD Wallet",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["inject.js", "icons/*"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  "permissions": ["storage"],
  "host_permissions": [
    "https://*.walletconnect.com/*",
    "https://*.walletconnect.org/*",
    "https://*.reown.com/*",
    "wss://*.walletconnect.com/*",
    "wss://*.walletconnect.org/*",
    "wss://*.reown.com/*"
  ]
}
