# Copy to .env in this directory. The quote service reads this file when you run npm run quote.
# Do not put DEPLOYER_PRIVATE_KEY here.

PORT=8787

# Swap quotes from 0x. https://dashboard.0x.org
# Without this key, swap quotes come from LI.FI only.
ZEROX_API_KEY=

# Bridge quotes and bridge status. https://li.fi
# Bridges work without a key, at the public rate limit.
LIFI_API_KEY=
LIFI_INTEGRATOR=knoad

# Leave both blank. A recipient turns on a swap fee. Sends never charge one.
# KNOAD_FEE_RECIPIENT=
# KNOAD_FEE_BPS=
