# Copy to .env in this directory. Expo reads it when the phone app starts.
# Restart Metro after any change. Expo inlines EXPO_PUBLIC_ values at bundle time.
# Do not put DEPLOYER_PRIVATE_KEY here.
# BUNDLER is an ERC-4337 bundler URL, not the factory or the account.
# Alchemy's node URL lists EntryPoint 0.9 and still refuses to estimate it.
# Use a bundler that runs v0.9. Pimlico: https://api.pimlico.io/v2/<chainId>/rpc?apikey=...
# The full checklist is docs/phone-setup.md.

EXPO_PUBLIC_KNOAD_RPC_84532=
EXPO_PUBLIC_KNOAD_BUNDLER_84532=
EXPO_PUBLIC_KNOAD_RPC_11155111=
EXPO_PUBLIC_KNOAD_BUNDLER_11155111=

# Ethereum and Base. Same bundler rule as the testnets.
EXPO_PUBLIC_KNOAD_RPC_1=
EXPO_PUBLIC_KNOAD_BUNDLER_1=
EXPO_PUBLIC_KNOAD_RPC_8453=
EXPO_PUBLIC_KNOAD_BUNDLER_8453=

# Reown project id from https://cloud.reown.com
# The app metadata URL is https://knoad.io. Pairing stays off until this is set.
EXPO_PUBLIC_WALLETCONNECT_PROJECT_ID=

# CoinGecko Demo key from https://www.coingecko.com/en/api
# Dollar totals and the chart stay on "Price unavailable" when this is empty and the public feed refuses the request.
EXPO_PUBLIC_COINGECKO_API_KEY=

# Quote service the phone can open. A real phone cannot use http://127.0.0.1.
# Use the computer's LAN address, for example http://10.x.x.x:8787, after npm run quote.
# Android Expo Go can use that HTTP address. If the phone refuses it, the service needs HTTPS.
EXPO_PUBLIC_KNOAD_QUOTE_URL=

# Set to 1 only when this phone should sign swaps and bridges. Leave unset to review quotes only.
# EXPO_PUBLIC_COMMERCE_SUBMIT=
