# Copy to .env in this directory. Forge reads that file when you run the deploy script.
# Fill the three values below, then broadcast Base Sepolia and then Sepolia.
# The key only pays gas. It is not an admin.

BASE_SEPOLIA_RPC_URL=
SEPOLIA_RPC_URL=
DEPLOYER_PRIVATE_KEY=

# Ethereum and Base. A broadcast on either chain also needs KNOAD_ALLOW_MAINNET=1.
# MAINNET_RPC_URL=
# BASE_RPC_URL=
# KNOAD_ALLOW_MAINNET=

# The phone app reads apps/mobile/.env. The quote service reads apps/quote/.env.
# Copy apps/quote/.env.example to apps/quote/.env. This Forge file does not load those keys.
# ZEROX_API_KEY=
# LIFI_API_KEY=
# LIFI_INTEGRATOR=knoad
# PORT=8787
# KNOAD_FEE_RECIPIENT=
# KNOAD_FEE_BPS=
